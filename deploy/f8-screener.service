[Unit]
Description=F8 F13 SEC Filing Screener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/F8_F13Screener
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/F8_F13Screener
# Single-filing alerts link to the dashboard. Without this the poller falls back
# to http://127.0.0.1:5173, which on a phone points at the phone itself.
# Keep in step with f8-heartbeat.service.
Environment=F13F_DASHBOARD_BASE_URL=https://13f.noeinsolutions.com
ExecStart=/opt/F8_F13Screener/venv/bin/python -m src.cli.main
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
# Give it a moment to finish in-flight Telegram sends before killing
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
