[Unit]
Description=F8 F13 Screener — FastAPI dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/F8_F13Screener
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/F8_F13Screener
# Loopback only: the one client is Vite on the same host (proxy /api -> 127.0.0.1:9002).
# Browsers reach it through https://13f.noeinsolutions.com, whose password this
# would bypass if the port answered from the internet.
Environment=API_SERVER_ADDRESS=127.0.0.1
# Port 9001 is taken on this host by another FastAPI app (F9_CongressTrading).
# F8 uses 9002; Vite is configured to proxy /api to 9002.
Environment=API_SERVER_PORT=9002
Environment=F8_API_PUBLIC_PORT=9002
# Vite proxies /api on the same origin, so CORS is only a safety net.
Environment=CORS_ORIGINS=https://13f.noeinsolutions.com,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
ExecStart=/opt/F8_F13Screener/venv/bin/python -m src.api
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target