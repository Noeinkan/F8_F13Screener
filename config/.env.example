# Configurazione 13F Alert System
# Copia questo file in .env e inserisci i tuoi valori

# Token del bot Telegram (ottienilo da @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Il tuo Chat ID Telegram (ottienilo da getUpdates)
TELEGRAM_CHAT_ID=123456789

# User Agent per SEC (deve includere il tuo email)
SEC_USER_AGENT=YourName yourname@email.com

# --- Notifiche (tutte opzionali: i default sono in src/core/config.py) ---

# Base URL del dashboard React, usato per i link dentro gli alert.
# Sul VPS: https://13f.noeinsolutions.com
F13F_DASHBOARD_BASE_URL=http://127.0.0.1:5173

# Ora locale del heartbeat quotidiano (0-23).
F13F_HEARTBEAT_HOUR=8

# Dopo quanti minuti senza un ciclo completato il poller e' considerato morto.
F13F_HEALTH_STALE_MINUTES=30

# Digest: quanto lasciar riempire la coda prima di inviarla, e il tetto oltre
# il quale si invia subito senza aspettare.
F13F_DIGEST_MIN_AGE_MINUTES=45
F13F_DIGEST_MAX_PENDING=20

# Quanti giorni prima della scadenza trimestrale inviare il promemoria.
F13F_REMINDER_DAYS_BEFORE=3
